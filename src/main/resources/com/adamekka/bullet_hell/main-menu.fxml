<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane minHeight="600.0" minWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adamekka.bullet_hell.MainMenuUIController">
   <children>
      <Canvas fx:id="canvas" height="200.0" width="200.0" />
      <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true" translateX="100.0">
         <image>
            <Image url="@main-menu.png" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="200.0" spacing="32.0" style="-fx-background-color: #FFFFFF;" translateX="-300.0">
         <children>
            <Label text="東方">
               <font>
                  <Font name="Ubuntu Nerd Font" size="64.0" />
               </font>
            </Label>
            <Button fx:id="play" mnemonicParsing="false" onAction="#onPlay" text="PLAY" />
            <Button fx:id="exit" mnemonicParsing="false" onAction="#onExit" text="EXIT" />
         </children>
      </VBox>
   </children>
</StackPane>
